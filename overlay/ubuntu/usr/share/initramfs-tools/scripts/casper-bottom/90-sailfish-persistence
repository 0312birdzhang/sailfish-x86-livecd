#!/bin/sh
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

# /cow is accessible before switch_root. Afterwards it is also the source
# name of the overlay mount, so findmnt /cow cannot identify its backing FS.
directory=/run/sailfish-persistence
mkdir -p "$directory"
set -- $(awk '$2 == "/cow" {print $1, $3; exit}' /proc/mounts)
device=${1:-unknown}
filesystem=${2:-unknown}
printf '%s\n' "$device" > "$directory/device"
printf '%s\n' "$filesystem" > "$directory/filesystem"
case "$filesystem" in
    tmpfs|unknown) printf 'temporary\n' > "$directory/mode" ;;
    *) printf 'persistent\n' > "$directory/mode" ;;
esac
